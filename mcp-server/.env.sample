# mcp-cronus server configuration.
# Copy to .env and fill in. Every key below is read by src/; nothing else is.

# Identity reported in the MCP initialize handshake
MCP_SERVER_NAME=mcp-cronus
MCP_SERVER_VERSION=1.0.0

# Port for the HTTP transport (npm run start:http)
MCP_HTTP_PORT=8080

# SQL Server holding the six demo tables
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=Cronus
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
